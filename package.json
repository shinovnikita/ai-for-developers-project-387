{
  "name": "call-calendar",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.ts",
    "demo:catalog": "node server/index.ts --demo-catalog",
    "dev": "vite frontend --host 127.0.0.1 --strictPort",
    "build": "tsc -b frontend && vite build frontend",
    "preview": "vite preview frontend --host 127.0.0.1 --strictPort",
    "generate:openapi": "tsp compile api",
    "generate:sdk": "openapi-ts -i api/generated/openapi.yaml -o api/generated/sdk -p @hey-api/client-fetch @hey-api/typescript @hey-api/sdk fastify",
    "lint": "oxlint --deny-warnings --react-plugin --vitest-plugin server frontend",
    "test": "vitest run",
    "test:workflows": "node --test scripts/*.checks.mjs",
    "test:browser": "npm run generate:openapi && npm run generate:sdk && playwright test",
    "typecheck": "tsc --noEmit && tsc -b frontend"
  },
  "dependencies": {
    "@fastify/static": "10.1.11",
    "@mantine/core": "9.8.1",
    "@mantine/hooks": "9.8.1",
    "fastify": "5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typespec/compiler": "1.18.0",
    "@typespec/http": "1.18.0",
    "@typespec/openapi3": "1.18.0",
    "@vitejs/plugin-react": "6.3.0",
    "js-yaml": "4.3.2",
    "oxlint": "1.93.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  }
}
